
# Inventory with real values
inventory/hosts.env

# Secrets
.env
*.key
*.pem
secrets/

# SSH keys (public keys can be shared via secure channel, ignore private)
*.key
*.pem
id_*
*.rsa
*.ed25519
!*.pub

# SSH private keys - NEVER commit
homelab-server
id_*
*.pem
*.key
*.rsa
*.ed25519
!*.pub
inventory/homelab-server

# SSH private keys
inventory/homelab-server
inventory/server

# Docker runtime data
stacks/*/*/data/
stacks/*/*/config/
stacks/*/*/workdir/
stacks/*/*/confdir/
stacks/*/*/cache/
stacks/*/*/ollama/
stacks/*/*/openwebui/
stacks/*/*/logs/
!stacks/*/*/config/.gitkeep
!stacks/security/gluetun/config/.gitkeep

# Ignore all docker runtime dirs
**/data/
**/config/
**/cache/
**/workdir/
**/confdir/
**/ollama/
**/openwebui/
**/logs/
**/servers/
!**/config/.gitkeep
